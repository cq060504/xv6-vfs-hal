index 0000000..1183d04
--- /dev/null
+++ b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_swtch.S
@@ -0,0 +1,39 @@
+# Context switch for LoongArch64.
+#
+#   void hal_switch(struct hal_context *old, struct hal_context *new);
+#
+# Save current callee-saved registers in *old. Load from *new.
+# a0 = old, a1 = new
+#
+# LoongArch callee-saved (12 registers):
+#   ra ($r1), sp ($r3), fp/$s9 ($r22), s0-s8 ($r23-$r31)
+
+.globl hal_switch
+hal_switch:
+        st.d    $ra, $a0, 0
+        st.d    $sp, $a0, 8
+        st.d    $fp, $a0, 16
+        st.d    $s0, $a0, 24
+        st.d    $s1, $a0, 32
+        st.d    $s2, $a0, 40
+        st.d    $s3, $a0, 48
+        st.d    $s4, $a0, 56
+        st.d    $s5, $a0, 64
+        st.d    $s6, $a0, 72
+        st.d    $s7, $a0, 80
+        st.d    $s8, $a0, 88
+
+        ld.d    $ra, $a1, 0
+        ld.d    $sp, $a1, 8
+        ld.d    $fp, $a1, 16
+        ld.d    $s0, $a1, 24
+        ld.d    $s1, $a1, 32
+        ld.d    $s2, $a1, 40
+        ld.d    $s3, $a1, 48
+        ld.d    $s4, $a1, 56
+        ld.d    $s5, $a1, 64
+        ld.d    $s6, $a1, 72
+        ld.d    $s7, $a1, 80
+        ld.d    $s8, $a1, 88
+
+        jirl    $r0, $ra, 0
diff --git a/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_tlbrefill.S b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_tlbrefill.S
new file mode 100644
index 0000000..246f509
--- /dev/null
+++ b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_tlbrefill.S
@@ -0,0 +1,103 @@
+# LoongArch software TLB refill handler.
+#
+# The CPU enters here through CSR.TLBRENTRY with DA=1/PG=0, so low
+# physical addresses are directly reachable. The page-table layout is the
+# four-level 9-9-9-9 scheme configured in kvminithart() via PWCL/PWCH.
+#
+# Accepted virtual addresses:
+#   User:   2*PGSIZE <= VA < MAXVA            (low half, via PGDL)
+#   Kernel: KSTACK_REGION_BOTTOM <= VA < KSTACK_TOP  (high half, via PGDH)
+
+#include "arch.h"
+
+.section .tlbrefill, "ax"
+.balign 4096
+.globl tlb_refill_entry
+tlb_refill_entry:
+        # Use TLBRSAVE as the single scratch save slot; do not touch ERA/PRMD.
+        csrwr   $t0, CSR_TLBRSAVE
+
+        # TLBREHI.VPPN is set by hardware, but PS is software-owned.
+        csrrd   $t0, CSR_TLBREHI
+        srli.d  $t0, $t0, 6
+        slli.d  $t0, $t0, 6
+        ori     $t0, $t0, 12
+        csrwr   $t0, CSR_TLBREHI
+
+        # --- VA validation ---
+        # Accept: user [2*PGSIZE, MAXVA) or kernel [KSTACK_REGION_BOTTOM, KSTACK_TOP)
+        csrrd   $t0, CSR_TLBRBADV
+
+        # Kernel addresses have bit 63 set (negative in signed comparison).
+        blt     $t0, $r0, .Lchk_kern
+
+        # User address: must be in [2*PGSIZE, MAXVA).
+        srli.d  $t0, $t0, 13           # reject VA < 2*PGSIZE
+        beqz    $t0, .Ltlbr_invalid
+        csrrd   $t0, CSR_TLBRBADV
+        srli.d  $t0, $t0, 38           # reject VA >= MAXVA
+        bnez    $t0, .Ltlbr_invalid
+        b       .Lrefill_ok
+
+.Lchk_kern:
+        # Kernel address: must be in [KSTACK_REGION_BOTTOM, KSTACK_TOP).
+        # KSTACK_REGION_BOTTOM = 0xFFFFFFFFFFF3F000
+        # KSTACK_TOP          = 0xFFFFFFFFFFFFF000
+        csrwr   $t1, CSR_KSAVE2       # KSave2 = old $t1
+        lu12i.w $t1, -193              # t1 = KSTACK_REGION_BOTTOM
+        bltu    $t0, $t1, .Ltlbr_kern_bad
+        lu12i.w $t1, -1               # t1 = KSTACK_TOP
+        bgeu    $t0, $t1, .Ltlbr_kern_bad
+        csrrd   $t1, CSR_KSAVE2       # restore $t1
+        # fall through to page-table walk
+
+.Lrefill_ok:
+        # PGD selects PGDL or PGDH from TLBRBADV in refill context.
+        csrrd   $t0, CSR_PGD           # PGD: selected root page-table PA
+
+        lddir   $t0, $t0, 3            # Dir2, VA[47:39]
+        andi    $t0, $t0, 1
+        beqz    $t0, .Ltlbr_invalid
+        csrrd   $t0, CSR_PGD
+        lddir   $t0, $t0, 3
+        addi.d  $t0, $t0, -1
+
+        lddir   $t0, $t0, 2            # Dir1, VA[38:30]
+        andi    $t0, $t0, 1
+        beqz    $t0, .Ltlbr_invalid
+        csrrd   $t0, CSR_PGD
+        lddir   $t0, $t0, 3
+        addi.d  $t0, $t0, -1
+        lddir   $t0, $t0, 2
+        addi.d  $t0, $t0, -1
+
+        lddir   $t0, $t0, 1            # Dir0, VA[29:21]
+        andi    $t0, $t0, 1
+        beqz    $t0, .Ltlbr_invalid
+        csrrd   $t0, CSR_PGD
+        lddir   $t0, $t0, 3
+        addi.d  $t0, $t0, -1
+        lddir   $t0, $t0, 2
+        addi.d  $t0, $t0, -1
+        lddir   $t0, $t0, 1
+        addi.d  $t0, $t0, -1
+
+        ldpte   $t0, 0                 # even page -> TLBRELO0
+        ldpte   $t0, 1                 # odd page  -> TLBRELO1
+        tlbfill
+
+        csrrd   $t0, CSR_TLBRSAVE
+        ertn
+
+.Ltlbr_kern_bad:
+        csrrd   $t1, CSR_KSAVE2       # restore $t1
+        # fall through to invalid path
+
+.Ltlbr_invalid:
+        # Install an invalid matching entry so retry reaches the normal
+        # PIL/PIS/PIF path instead of looping forever in TLB refill.
+        csrwr   $r0, CSR_TLBRELO0     # TLBRELO0
+        csrwr   $r0, CSR_TLBRELO1     # TLBRELO1
+        tlbfill
+        csrrd   $t0, CSR_TLBRSAVE
+        ertn
diff --git a/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_tramp.S b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_tramp.S
new file mode 100644
index 0000000..e0af81e
--- /dev/null
+++ b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_tramp.S
@@ -0,0 +1,140 @@
+# LoongArch64 user <-> kernel trap trampoline.
+#
+# When a user-space (PLV3) trap occurs:
+#   Hardware saves: CRMD.PLV -> PRMD.PPLV, CRMD.IE -> PRMD.PIE
+#                   PC -> ERA, CRMD.PLV=0, CRMD.IE=0, PC=EENTRY
+#
+# DMW0 (VSEG=0, PLV0=1) identity-maps all VA[63:60]=0 for kernel mode,
+# so the kernel accesses physical addresses directly.  The trampoline is
+# placed at its flash LMA (0x1C008000) so DMW0 reaches the real code.
+#
+# Trapframe access: KSave1 holds the *kernel* virtual address
+# of the current process's trapframe (p->trapframe).  This KVA is in the
+# DMW0 identity-mapped window, so uservec/userret can read/write the
+# trapframe without going through the user page table or the TRAPFRAME VA.
+#
+# KSave0 is used to save/restore user a0 across the transition.
+
+#include "arch.h"
+#include "memlayout.h"
+
+.section trampsec
+.globl trampoline
+.globl usertrap
+
+trampoline:
+.align 4
+.globl uservec
+uservec:
+        # Swap user a0 with KSave0; then load trapframe KVA from KSave1.
+        csrwr   $a0, CSR_KSAVE0        # KSave0=user_a0 (a0 gets old KSave0, ignored)
+        csrrd   $a0, CSR_KSAVE1        # a0 = KSave1 = p->trapframe (KVA, DMW0-accessible)
+
+        # Save all user registers to trapframe via KVA (DMW0 identity-mapped).
+        # Offsets match struct trapframe in proc.h.
+        st.d    $ra, $a0, 40
+        st.d    $sp, $a0, 48
+        st.d    $r0, $a0, 56           # gp slot -- LoongArch has no gp
+        st.d    $tp, $a0, 64
+        st.d    $t0, $a0, 72
+        st.d    $t1, $a0, 80
+        st.d    $t2, $a0, 88
+        st.d    $s0, $a0, 96
+        st.d    $s1, $a0, 104
+        st.d    $a1, $a0, 120
+        st.d    $a2, $a0, 128
+        st.d    $a3, $a0, 136
+        st.d    $a4, $a0, 144
+        st.d    $a5, $a0, 152
+        st.d    $a6, $a0, 160
+        st.d    $a7, $a0, 168
+        st.d    $s2, $a0, 176
+        st.d    $s3, $a0, 184
+        st.d    $s4, $a0, 192
+        st.d    $s5, $a0, 200
+        st.d    $s6, $a0, 208
+        st.d    $s7, $a0, 216
+        st.d    $s8, $a0, 224
+        st.d    $fp, $a0, 232          # fp = $r22 (s9 slot)
+        st.d    $r0, $a0, 240          # s10 slot -- no LA equivalent
+        st.d    $r0, $a0, 248          # s11 slot
+        st.d    $t3, $a0, 256
+        st.d    $t4, $a0, 264
+        st.d    $t5, $a0, 272
+        st.d    $t6, $a0, 280
+
+        # Recover user a0 from KSave0 and store to trapframe->a0.
+        csrrd   $t0, CSR_KSAVE0
+        st.d    $t0, $a0, 112
+
+        # Save user pc (ERA) to trapframe->epc.
+        csrrd   $t0, CSR_ERA            # ERA
+        st.d    $t0, $a0, 24
+
+        # Load kernel stack pointer from trapframe.
+        ld.d    $sp, $a0, 8
+
+        # Load kernel hartid into tp.
+        ld.d    $tp, $a0, 32
+
+        # Load address of usertrap() handler.
+        ld.d    $t0, $a0, 16
+
+        # Load kernel page table base.
+        ld.d    $t1, $a0, 0
+
+        # Switch to kernel page table (no invtlb — kernel uses DMW, not TLB).
+        csrwr   $t1, CSR_PGDL           # PGDL = kernel page table
+
+        # Call usertrap().  Use $ra so usertrap() can return to userret.
+        jirl    $ra, $t0, 0
+
+.globl userret
+userret:
+        # usertrap() returns here with the user page table in a0.
+
+        # Switch to user page table.
+        csrwr   $a0, CSR_PGDL           # PGDL = user page table
+        invtlb  0, $r0, $r0
+
+        # Load trapframe KVA from KSave1 (DMW0-accessible, per-process).
+        csrrd   $a0, CSR_KSAVE1         # a0 = p->trapframe KVA
+
+        # Restore all user registers from trapframe.
+        # a0 is the base pointer, restored LAST.
+        ld.d    $ra, $a0, 40
+        ld.d    $sp, $a0, 48
+        # skip gp -- LoongArch has no gp
+        ld.d    $tp, $a0, 64
+        ld.d    $t0, $a0, 72
+        ld.d    $t1, $a0, 80
+        ld.d    $t2, $a0, 88
+        ld.d    $s0, $a0, 96
+        ld.d    $s1, $a0, 104
+        ld.d    $a1, $a0, 120
+        ld.d    $a2, $a0, 128
+        ld.d    $a3, $a0, 136
+        ld.d    $a4, $a0, 144
+        ld.d    $a5, $a0, 152
+        ld.d    $a6, $a0, 160
+        ld.d    $a7, $a0, 168
+        ld.d    $s2, $a0, 176
+        ld.d    $s3, $a0, 184
+        ld.d    $s4, $a0, 192
+        ld.d    $s5, $a0, 200
+        ld.d    $s6, $a0, 208
+        ld.d    $s7, $a0, 216
+        ld.d    $s8, $a0, 224
+        ld.d    $fp, $a0, 232
+        ld.d    $t3, $a0, 256
+        ld.d    $t4, $a0, 264
+        ld.d    $t5, $a0, 272
+        ld.d    $t6, $a0, 280
+
+        # Restore user a0 last (it was the base pointer).
+        ld.d    $a0, $a0, 112
+
+        # ERA and PRMD already set by prepare_return() in trap.c.
+        # ertn uses ERA for the return PC and PRMD.PPLV/PIE for
+        # mode/interrupt configuration.
+        ertn
diff --git a/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_uart.c b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_uart.c
new file mode 100644
index 0000000..5181f6c
--- /dev/null
+++ b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_uart.c
@@ -0,0 +1,126 @@
+// LoongArch 16550a UART driver.
+//
+// Interrupts: QEMU 8.2.2 does NOT deliver UART interrupts to the CPU.
+// The 16550→PCH-PIC→EIOINTC chain is broken (verified empirically:
+// 16550 IIR shows pending, PCH-PIC is unmasked, but EIOINTC COREISR
+// never latches and ESTAT.IS12 never fires).  Therefore both TX and RX
+// use only LSR polling — no interrupt-driven I/O is possible at guest
+// level on this QEMU version.
+//
+// TX: hal_putchar() spin-waits on LSR_TX_IDLE before writing THR.
+//     hal_console_write() loops over hal_putchar().
+// RX: hal_console_intr() polls LSR_RX_READY in a drain loop.
+//     clockintr() calls hal_console_poll() each timer tick, which
+//     delegates to hal_console_intr() to drain any buffered input.
+
+#include "types.h"
+#include "hal/hal.h"
+#include "defs.h"
+
+#define Reg(reg) ((volatile unsigned char *)(UART0 + (reg)))
+
+#define ReadReg(reg) (*(Reg(reg)))
+#define WriteReg(reg, v) (*(Reg(reg)) = (v))
+
+#define RHR 0          // Receive Holding Register
+#define THR 0          // Transmit Holding Register
+#define IER 1          // Interrupt Enable Register
+#define FCR 2          // FIFO Control Register
+#define ISR 2          // Interrupt Status Register
+#define LCR 3          // Line Control Register
+#define LSR 5          // Line Status Register
+
+#define LSR_RX_READY (1<<0)
+#define LSR_TX_IDLE  (1<<5)
+
+// Interrupt Enable Register bits
+#define IER_RX_ENABLE (1<<0)
+#define IER_TX_ENABLE (1<<1)
+
+// FIFO Control Register bits
+#define FCR_FIFO_ENABLE (1<<0)
+#define FCR_FIFO_CLEAR  (3<<1)  // clear RX + TX FIFO
+
+// Line Control Register bits
+#define LCR_EIGHT_BITS (3<<0)
+#define LCR_BAUD_LATCH (1<<7)   // DLAB
+
+// QEMU's 16550 baud base is 115.2K; divisor 3 selects 38.4K.
+#define BAUD_DIV 3
+
+extern volatile int panicking;
+extern volatile int panicked;
+
+void
+hal_console_init(void)
+{
+  // Disable interrupts during init.
+  WriteReg(IER, 0x00);
+
+  // Set baud rate to 38.4K.
+  WriteReg(LCR, LCR_BAUD_LATCH);
+  WriteReg(0, BAUD_DIV & 0xff);          // DLL (divisor low)
+  WriteReg(1, (BAUD_DIV >> 8) & 0xff);   // DLM (divisor high)
+
+  // 8 data bits, 1 stop bit, no parity; clear DLAB.
+  WriteReg(LCR, LCR_EIGHT_BITS);
+
+  // Enable and reset FIFOs.
+  WriteReg(FCR, FCR_FIFO_ENABLE | FCR_FIFO_CLEAR);
+
+  // Enable RX interrupt in the 16550 IER so IIR reflects pending state.
+  // Interrupt will NOT reach the CPU on QEMU 8.2.2; actual RX is via
+  // hal_console_poll() → hal_console_intr() → LSR polling on each tick.
+  WriteReg(IER, IER_RX_ENABLE);
+}
+
+void
+hal_console_write(char buf[], int n)
+{
+  for(int i = 0; i < n; i++)
+    hal_putchar(buf[i]);
+}
+
+void
+hal_putchar(int c)
+{
+  if(panicking == 0)
+    push_off();
+  if(panicked){
+    for(;;)
+      ;
+  }
+  // Wait until the transmit holding register can accept another byte.
+  while((ReadReg(LSR) & LSR_TX_IDLE) == 0)
+    ;
+  WriteReg(THR, c);
+  if(panicking == 0)
+    pop_off();
+}
+
+static int
+uart_getc(void)
+{
+  if(ReadReg(LSR) & LSR_RX_READY)
+    return ReadReg(RHR);
+  else
+    return -1;
+}
+
+void
+hal_console_intr(void (*handler)(int))
+{
+  ReadReg(ISR);
+  while(1){
+    int c = uart_getc();
+    if(c == -1)
+      break;
+    handler(c);
+  }
+}
+
+void
+hal_console_poll(void (*handler)(int))
+{
+  hal_console_intr(handler);
+}
diff --git a/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_vm.c b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_vm.c
new file mode 100644
index 0000000..6f19a96
--- /dev/null
+++ b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/hal_vm.c
@@ -0,0 +1,97 @@
+#include "types.h"
+#include "hal/hal.h"
+#include "defs.h"
+
+#define USER_LOW_GUARD_PAGES 2
+
+// NPROC=64 → 64*3=192 pages.  KSTACK_REGION_BOTTOM must be exactly
+// KSTACK_TOP - (NPROC * 3) * PGSIZE.  If NPROC changes without updating
+// memlayout.h, the stack region will be wrong and the refill handler
+// will reject valid kernel stack VAs or accept invalid ones.
+_Static_assert(KSTACK_TOP - KSTACK_REGION_BOTTOM == 192 * 4096,
+               "KSTACK_REGION_BOTTOM not aligned with NPROC — check memlayout.h");
+
+extern void tlb_refill_entry(void);
+
+// DMW0 (PLV0, VSEG=0) identity-maps all low physical addresses for kernel
+// mode, so the kernel never walks PGDL/PGDH for low-address accesses.
+// High-address kernel stacks are mapped separately via PGDH and
+// proc_mapstacks().  Therefore hal_vm_map_kernel() is intentionally a
+// no-op — building dead page-table entries would waste memory (~40 pages)
+// and imply a page-table dependency that does not exist.
+void
+hal_vm_map_kernel(pagetable_t kpgtbl)
+{
+  (void)kpgtbl;
+}
+
+void
+hal_vm_enable(pagetable_t kpgtbl)
+{
+  hal_tlb_flush_all();
+  hal_write_satp(MAKE_SATP(kpgtbl));
+  w_pgdh(MAKE_SATP(kpgtbl));
+  hal_tlb_flush_all();
+
+  // PLV0, cacheable, VSEG=0. High kernel stacks still use PGDH.
+  w_dmw0(0x0000000000000011ULL);
+  w_dmw1(0);
+  hal_tlb_flush_all();
+
+  // Four 9-bit levels at VA[47:39], [38:30], [29:21], and [20:12].
+  w_pwcl((12UL << 0) | (9UL << 5) | (21UL << 10) |
+         (9UL << 15) | (30UL << 20) | (9UL << 25));
+  w_pwch((39UL << 0) | (9UL << 6));
+  w_rvacfg(8);
+  w_tlbrentry((uint64)tlb_refill_entry);
+
+  uint64 crmd = r_crmd();
+  crmd &= ~CRMD_DA;
+  crmd |= CRMD_PG;
+  w_crmd(crmd);
+}
+
+int
+hal_vm_map_trampoline(pagetable_t pagetable,
+                      uint64 trampoline_pa,
+                      uint64 trapframe_pa)
+{
+  (void)pagetable;
+  (void)trampoline_pa;
+  (void)trapframe_pa;
+  return 0;
+}
+
+void
+hal_vm_unmap_trampoline(pagetable_t pagetable)
+{
+  (void)pagetable;
+}
+
+int
+hal_vm_reserve_user_low(pagetable_t pagetable, uint64 *initial_sz)
+{
+  uint64 mapped = 0;
+  *initial_sz = 0;
+
+  for(int i = 0; i < USER_LOW_GUARD_PAGES; i++){
+    char *guard = kalloc();
+    if(guard == 0)
+      goto fail;
+    memset(guard, 0, PGSIZE);
+    if(mappages(pagetable, mapped, PGSIZE,
+                (uint64)guard, PTE_R) < 0){
+      kfree(guard);
+      goto fail;
+    }
+    mapped += PGSIZE;
+  }
+
+  *initial_sz = mapped;
+  return 0;
+
+fail:
+  if(mapped != 0)
+    uvmunmap(pagetable, 0, mapped / PGSIZE, 1);
+  return -1;
+}
diff --git a/xv6-riscv-xv6-riscv-rev5/hal/loongarch/kernel.ld b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/kernel.ld
new file mode 100644
index 0000000..69bd20f
--- /dev/null
+++ b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/kernel.ld
@@ -0,0 +1,65 @@
+OUTPUT_ARCH("loongarch")
+ENTRY(_entry)
+
+SECTIONS
+{
+  /*
+   * Simple layout: everything at VMA 0x1c000000.
+   * .data and .bss have AT() in flash, start() copies them to RAM at 0x00400000.
+   */
+  . = 0x1c000000;
+
+  .text.boot : {
+    *(.text.entry)
+  }
+  ASSERT(. <= 0x1c008000, ".text.boot overflow into .tlbrefill — reduce .text.entry size")
+
+  /* TLB refill and trampoline live at fixed pages used by memlayout.h. */
+  . = 0x1c008000;
+  .tlbrefill : {
+    *(.tlbrefill)
+  }
+
+  . = 0x1c009000;
+  .trampoline : {
+    _trampoline = .;
+    *(trampsec)
+    . = ALIGN(0x1000);
+    ASSERT(. - _trampoline == 0x1000, "error: trampoline larger than one page");
+  }
+
+  . = 0x1c00a000;
+  .text : {
+    *(.text .text.*)
+    PROVIDE(etext = .);
+  }
+
+  .rodata : { *(.rodata .rodata.*) }
+  .eh_frame : { *(.eh_frame) }
+
+  /* .data LMA follows eh_frame. VMA goes to RAM. */
+  _data_lma = ALIGN(4096);
+
+  . = 0x00400000;
+  .data : AT(_data_lma) {
+    _data_start = .;
+    *(.data .data.*) *(.got .got.*)
+    . = ALIGN(16);
+  }
+
+  .bss (NOLOAD) : {
+    . = ALIGN(4096);
+    _bss_start = .;
+    *(.bss .bss.*)
+    . = ALIGN(4096);
+    _bss_end = .;
+  }
+
+  .bootstack (NOLOAD) : {
+    . = ALIGN(16);
+    *(.bootstack)
+    . = ALIGN(4096);
+  }
+
+  PROVIDE(end = .);
+}
diff --git a/xv6-riscv-xv6-riscv-rev5/hal/loongarch/memlayout.h b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/memlayout.h
new file mode 100644
index 0000000..159836c
--- /dev/null
+++ b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/memlayout.h
@@ -0,0 +1,94 @@
+// LoongArch physical memory layout for qemu -machine virt (LS7A chipset).
+//
+// Based on QEMU hw/loongarch/virt.c:
+//
+// 00000000 -- Low RAM (256 MB for xv6)
+// 0FE00000 -- EIOINTC (extended I/O interrupt controller)
+// 1FE001E0 -- UART0 (COM1, 16550a)
+// 1C000000 -- Firmware/BIOS flash (kernel loaded here via -bios)
+//
+// DMW0 (VSEG=0, PLV=PLV0) identity-maps VA[63:60]=0 -> PA=VA for kernel
+// direct access to: .data/.bss (0x00400000), .text/flash (0x1c000000),
+// UART, EIOINTC, and the trampoline page.
+//
+// Kernel stacks live at high VA (VA[63]=1) outside DMW0, accessed through
+// PGDH page table. This enables real guard pages: a stack overflow moves sp
+// into an unmapped page and triggers a PIL/PIS exception instead of silently
+// corrupting the next process's stack through the DMW0 alias.
+// Trapframe is accessed via KSave1 (kernel VA), not via TRAPFRAME VA.
+
+#ifndef _HAL_LOONGARCH_MEMLAYOUT_H_
+#define _HAL_LOONGARCH_MEMLAYOUT_H_
+
+// QEMU puts 16550a UART registers here in physical memory.
+// UART0_IRQ: serial irq goes to PCH-PIC input 2 (VIRT_UART_IRQ(66)-VIRT_GSI_BASE(64)),
+// but PCH-PIC htmsi_vector[] resets to all zeros, so every input is routed to
+// PCH-PIC output 0 = EIOINTC line 0.  Hence UART0_IRQ is EIOINTC line 0.
+#define UART0 0x1FE001E0L
+#define UART0_IRQ 0
+
+// virtio on LoongArch is PCI-based, not MMIO.
+#define VIRTIO0_IRQ 32
+
+// Extended I/O Interrupt Controller base address.
+#define EIOINTC 0x0FE00000L
+
+// Kernel code in flash at VMA 0x1c000000. Kernel data in RAM at 0x00400000.
+// PHYSTOP = start of kernel data in RAM + 124MB usable RAM.
+#define KERNBASE 0x1C000000L
+#define PHYSTOP (0x00400000L + 124*1024*1024)
+
+// QEMU loader-backed RAM disks. This region is above PHYSTOP and the kernel
+// stacks, so kalloc cannot overwrite it. Three 16 MiB windows end below the
+// 256 MiB low-RAM boundary.
+#define RAMDISK_BASE   0x09000000L
+#define RAMDISK_STRIDE (16*1024*1024L)
+
+// Low-address objects placed where DMW0 (VA[63:60]=0) reaches them directly:
+//   TRAMPOLINE = 0x1C009000  (_trampoline symbol in flash, after .tlbrefill page)
+//   TRAPFRAME  —  per-process, accessed via KSave1 holding p->trapframe KVA;
+//                 keeps the xv6 high user-VA value for sbrk/usertests only.
+//
+// TRAMPOLINE is the actual low VA used by EENTRY/userret. TRAPFRAME keeps the
+// original xv6 high user-VA contract for sbrk/usertests only; LoongArch never
+// maps or dereferences that VA on the trap path.
+//
+// Kernel stacks are at high addresses (KSTACK_TOP downwards), outside DMW0.
+// Each process gets 3 pages: 2 mapped for the stack + 1 unmapped guard below.
+// The guard has no PTE → true stack overflow → PIL/PIS exception.
+#define TRAMPOLINE 0x1C009000L
+#define TRAPFRAME  (MAXVA - 2*PGSIZE)
+
+// One byte past the largest user address that sbrk may create.
+// RISC-V uses TRAPFRAME as this guard; keep the same contract for tests.
+#define USER_TOP TRAPFRAME
+
+
+// Kernel stacks: descending from high VA, outside DMW0.
+// 3*PGSIZE per process (2 mapped + 1 unmapped guard). NPROC=64.
+//
+// Layout for process p (top→bottom):
+//   KSTACK(p) + 2*PGSIZE  ← initial sp (stack grows downward)
+//   KSTACK(p) + 1*PGSIZE  ← second usable page
+//   KSTACK(p)             ← first usable page (mapped, PTE_R|PTE_W)
+//   KSTACK(p) - 1*PGSIZE  ← guard page (NO PTE → PIL/PIS on overflow)
+//
+// Constraints verified for NPROC=64, PGSIZE=4096:
+//   KSTACK(p) % PGSIZE == 0  (page-aligned)
+//   KSTACK(p) + 2*PGSIZE <= KSTACK_TOP  (fits in window)
+//   KSTACK(NPROC-1) - PGSIZE >= KSTACK_REGION_BOTTOM  (last guard in range)
+#define KSTACK_TOP            0xFFFFFFFFFFFFF000ULL
+#define KSTACK(p)             (KSTACK_TOP - ((uint64)(p) * 3 + 2) * PGSIZE)
+// NPROC = 64 → region spans 64 * 3 = 192 pages (128 mapped + 64 guard)
+#define KSTACK_REGION_BOTTOM  (KSTACK_TOP - 192 * PGSIZE)
+
+#ifndef __ASSEMBLER__
+// --- Page table walk address validation ---
+// Returns 1 if va is a legal address for the page-table walker:
+// user space [0, MAXVA) or high kernel stack region.
+static inline int hal_pagetable_va_valid(uint64 va) {
+    return (va < MAXVA) || (va >= KSTACK_REGION_BOTTOM && va < KSTACK_TOP);
+}
+#endif
+
+#endif
diff --git a/xv6-riscv-xv6-riscv-rev5/hal/loongarch/user.ld b/xv6-riscv-xv6-riscv-rev5/hal/loongarch/user.ld
