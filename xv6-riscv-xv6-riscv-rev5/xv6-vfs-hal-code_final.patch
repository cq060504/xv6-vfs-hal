+{
+  int i;
+  for(i = 1; i < nmount; i++){
+    if(mounttable[i]->root &&
+       mounttable[i]->root->dev == vp->dev &&
+       mounttable[i]->root->inum == vp->inum)
+      return mounttable[i];
+  }
+  return 0;
+}
