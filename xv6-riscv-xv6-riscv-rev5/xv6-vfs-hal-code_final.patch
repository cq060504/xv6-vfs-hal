+  uchar  DIR_NTRes;           // 0x0C: reserved for NT
+  uchar  DIR_CrtTimeTenth;    // 0x0D: creation time (tenths of second)
+  ushort DIR_CrtTime;         // 0x0E: creation time
+  ushort DIR_CrtDate;         // 0x10: creation date
